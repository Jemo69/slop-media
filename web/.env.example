# R2 (Cloudflare, free 10GB, zero egress)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=slop-media
# Public R2 bucket URL (r2.dev subdomain or custom domain) — video bytes serve from here, NOT via Vercel (saves bandwidth)
R2_PUBLIC_URL=https://pub-xxx.r2.dev
# Shared secret: CLI sends Authorization: Bearer <token>
UPLOAD_TOKEN=change-me
# CLI side:
# SLOP_MEDIA_URL=https://slop-media.vercel.app
# SLOP_MEDIA_TOKEN=same-as-UPLOAD_TOKEN
